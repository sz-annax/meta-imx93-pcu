From 3aa45a45e5fd64b4635b4b820361f83dd59106e0 Mon Sep 17 00:00:00 2001
From: bigzhu <sudazzj@qq.com>
Date: Wed, 25 Jun 2025 13:57:30 +0800
Subject: [PATCH] fix environment_saved

Upstream-Status: Pending

Signed-off-by: bruce <zhengjing.zhu@wabtec.com>

---
 include/configs/imx93_evk.h | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/include/configs/imx93_evk.h b/include/configs/imx93_evk.h
index 042e7a6bbab..e805ae838d3 100644
--- a/include/configs/imx93_evk.h
+++ b/include/configs/imx93_evk.h
@@ -165,12 +165,12 @@
 			"fi;" \
 		"fi;\0" \
 	"bsp_bootcmd=echo Running BSP bootcmd ...; " \
-		"if test ${environment_saved} = yes; then " \
+		"if test -n ${environment_saved} && test ${environment_saved} = yes; then " \
 			"echo Environment already saved; " \
 		"else " \
 			"echo Saving default environment to eMMC; " \
 			"setenv environment_saved yes; " \
-			"savenv; " \
+			"saveenv; " \
 		"fi; " \
 		"mmc dev ${mmcdev}; if mmc rescan; then " \
 		   "if run loadbootscript; then " \
@@ -182,7 +182,7 @@
 				   "else run netboot; " \
 				   "fi; " \
 			    "else " \
-					"if test ${recovery_op} = start || || test ${recovery_pending_cnt} = 3; then " \
+					"if test ${recovery_op} = start || test ${recovery_pending_cnt} = 3; then " \
 						"run recoveryboot; " \
 					"else " \
 						"if run loadimage; then " \
