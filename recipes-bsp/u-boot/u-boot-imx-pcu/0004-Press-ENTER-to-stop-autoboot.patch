From 52f09e879237035c5e2b23eed66b9f480b0898b6 Mon Sep 17 00:00:00 2001
From: bigzhu <sudazzj@qq.com>
Date: Wed, 25 Jun 2025 13:30:29 +0800
Subject: [PATCH] Press ENTER to stop autoboot

Upstream-Status: Pending

Signed-off-by: bruce <zhengjing.zhu@wabtec.com>

---
 configs/imx93_11x11_evk_defconfig | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/configs/imx93_11x11_evk_defconfig b/configs/imx93_11x11_evk_defconfig
index 93b5c5a6575..51434449db7 100644
--- a/configs/imx93_11x11_evk_defconfig
+++ b/configs/imx93_11x11_evk_defconfig
@@ -55,6 +55,10 @@ CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x1040
 CONFIG_SPL_I2C=y
 CONFIG_SPL_POWER=y
 CONFIG_SPL_WATCHDOG=y
+CONFIG_AUTOBOOT_KEYED=y
+CONFIG_AUTOBOOT_PROMPT="Press ENTER to stop autoboot: %d\n"
+CONFIG_AUTOBOOT_STOP_STR="\r"
+CONFIG_AUTOBOOT_DELAY_STR=""
 CONFIG_SYS_PROMPT="u-boot=> "
 CONFIG_CMD_ERASEENV=y
 CONFIG_CMD_NVEDIT_EFI=y
