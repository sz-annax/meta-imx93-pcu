Subject: [PATCH] pmq: use public time_t for timespec seconds

C long is 32 bits on ARM32 even when glibc uses the 64-bit time ABI.
Use the public time_t typedef from time.h so cgo follows the target ABI
on both ARM32 and ARM64 without naming glibc's private __time64_t type.

Upstream-Status: Pending

diff --git a/pmq/wrapper.go b/pmq/wrapper.go
--- a/pmq/wrapper.go
+++ b/pmq/wrapper.go
@@ -7,6 +7,7 @@
 #include <signal.h>
 #include <fcntl.h>
 #include <mqueue.h>
+#include <time.h>
 
 // Expose non-variadic function requires 4 arguments.
 mqd_t mq_open4(const char *name, int oflag, int mode, struct mq_attr *attr) {
@@ -63,6 +64,6 @@
 func timeToTimespec(t time.Time) C.struct_timespec {
 	return C.struct_timespec{
-		tv_sec:  C.long(t.Unix()),
+		tv_sec:  C.time_t(t.Unix()),
 		tv_nsec: C.long(t.Nanosecond() % 1000000000),
 	}
 }
