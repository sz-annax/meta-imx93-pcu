CONFIG_ARM=y
CONFIG_ARCH_MX6=y
CONFIG_MX6DL=y
CONFIG_TARGET_MX6DLSABRESD=y
CONFIG_SYS_MALLOC_LEN=0x1000000
CONFIG_NR_DRAM_BANKS=1
CONFIG_ENV_SIZE=0x2000
CONFIG_ENV_IS_NOWHERE=y
CONFIG_IMX_CONFIG="board/freescale/mx6sabresd/mx6dlsabresd.cfg"
CONFIG_DEFAULT_DEVICE_TREE="imx6dl-imx6u-lcd"
CONFIG_BOOTDELAY=3
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="for mmcdev in 1 3; do if mmc dev ${mmcdev} 0 && mmc rescan; then if load mmc ${mmcdev}:1 ${loadaddr} zImage && load mmc ${mmcdev}:1 ${fdt_addr_r} imx6dl-imx6u-lcd.dtb && part uuid mmc ${mmcdev}:2 rootuuid; then setenv bootargs console=ttymxc0,115200 earlycon root=PARTUUID=${rootuuid} rootwait rw; bootz ${loadaddr} - ${fdt_addr_r}; fi; fi; done"
CONFIG_HUSH_PARSER=y
CONFIG_SYS_MAXARGS=32
CONFIG_SYS_PBSIZE=532
CONFIG_BOUNCE_BUFFER=y
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_MEMTEST=y
CONFIG_CMD_MMC=y
CONFIG_CMD_PART=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_CACHE=y
CONFIG_CMD_CRC32=y
CONFIG_CRC32_VERIFY=y
CONFIG_SUPPORT_EMMC_BOOT=y
CONFIG_OF_CONTROL=y
CONFIG_DM_GPIO=y
CONFIG_DM_MMC=y
CONFIG_FSL_USDHC=y
CONFIG_DM_SERIAL=y
CONFIG_MXC_UART=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_IMX6=y
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_FIXED=y
CONFIG_IMX_THERMAL=y
CONFIG_SYS_RELOC_GD_ENV_ADDR=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_MANUFACTURER="FSL"
CONFIG_USB_GADGET_VENDOR_NUM=0x1fc9
CONFIG_USB_GADGET_PRODUCT_NUM=0x0152
CONFIG_CI_UDC=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_UUU_SUPPORT=y
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_BUF_ADDR=0x20000000
CONFIG_FASTBOOT_BUF_SIZE=0x10000000
